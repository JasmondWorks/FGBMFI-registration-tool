# Postgres (Neon works as-is, including the pooled URL with channel_binding=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary backup of every badge file. Leave empty to run fully offline (local copies only).
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Where badge files are kept on this laptop. The printing always uses these local copies.
STORAGE_DIR="./storage"

# Required to use Settings > Danger zone > Clear all data. Pick your own PIN; without this
# set, the reset endpoint refuses to run at all.
RESET_PIN="change-me"
